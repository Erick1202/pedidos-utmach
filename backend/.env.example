# Conexión a MongoDB local.
# Usa 127.0.0.1 (no "localhost") para evitar que Node resuelva IPv6 (::1) en Windows.
MONGODB_URI=mongodb://127.0.0.1:27017/pedidos_utmach

# Secreto para firmar los JWT. En producción usa un valor largo y aleatorio.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

PORT=3000

# Orígenes permitidos por CORS, separados por comas (sin ruta ni barra final).
# Por defecto: el frontend local y la app publicada en GitHub Pages.
CORS_ORIGINS=http://localhost:4200,https://erick1202.github.io
